  "main": "index.js",
  "scripts": {
    "dev": "tsup src/server.ts --watch --onSuccess \"node dist/server.js\"",
    "build": "tsup",
    "postinstall": "prisma generate",
    "render-build": "npm run build",
    "start": "node dist/server.js",
    "db:test:up": "docker-compose up -d db-test",
    "db:test:down": "docker-compose down",
    "db:test:migrate": "dotenv -e .env.test -- npx prisma migrate deploy",
    "test": "NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test jest --runInBand --detectOpenHandles"
  },
