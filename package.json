    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "prisma": "^7.2.0",
